# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Set MONGODB_URI to your MongoDB connection string (e.g., local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/quickmart
# When set to true or if local MongoDB is unavailable, an in-memory MongoDB instance will be used for testing/dev
USE_IN_MEMORY_DB=false

# Security & Authentication
JWT_SECRET=quickmart_super_secure_jwt_secret_dev_2026_change_in_prod
JWT_EXPIRES_IN=30d

# SMS Provider Configuration
# Supported values: dev | fast2sms | msg91 | twilio
# In 'dev' mode, OTP is logged to console and returned in development responses for seamless testing
SMS_PROVIDER=dev
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=QKMART

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Default Hyperlocal Delivery Store Configuration (Rural/Semi-urban Hub)
# Coordinates for fulfillment center/store (e.g., Anand, Gujarat semi-urban hub)
STORE_LATITUDE=22.5645
STORE_LONGITUDE=72.9289
STORE_NAME=QuickMart Anand Rural Hub
STORE_ADDRESS=Main Market Road, Anand Rural Distribution Center, Anand 388001

# Delivery Service Area Settings
DELIVERY_RADIUS_KM=15
BASE_DELIVERY_FEE=25
FREE_DELIVERY_THRESHOLD=299
MIN_ORDER_AMOUNT=99
ESTIMATED_SPEED_KMH=25
PREPARATION_TIME_MINUTES=15
